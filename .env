# Local test credentials for the Payyar demo stack (NOT production secrets).
# Every service reads its settings from this file via docker-compose.yml.

TZ_REPORT=Asia/Tehran

# Python package index used when building the tools image. Inside Iran, where
# files.pythonhosted.org is often unreachable, use a mirror such as
# https://package-mirror.liara.ir/repository/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple

# --- Source OLTP (PostgreSQL) ---
PG_DB=payyar
PG_ADMIN_USER=payyar_admin
PG_ADMIN_PASSWORD=admin_pw_local
PG_APP_USER=payyar_app
PG_APP_PASSWORD=app_pw_local
PG_CDC_USER=debezium
PG_CDC_PASSWORD=cdc_pw_local
PG_READER_USER=bi_reader
PG_READER_PASSWORD=reader_pw_local

# --- Seed volume ---
SEED_MERCHANTS=2000
SEED_TRANSACTIONS=5000000
SEED_DAYS=180

# --- Analytics (ClickHouse) ---
CH_ADMIN_USER=ch_admin
CH_ADMIN_PASSWORD=ch_admin_pw_local
# read-only operator account used by the ops tooling (benchmark, e2e test)
CH_ETL_USER=etl
CH_ETL_PASSWORD=etl_pw_local
CH_METABASE_USER=metabase
CH_METABASE_PASSWORD=mb_ch_pw_local
# Secret key for pseudonymising national id / mobile (salted SHA-256).
PII_SALT=local-demo-salt-change-me

# --- Metabase ---
MB_ADMIN_EMAIL=admin@payyar.local
MB_ADMIN_PASSWORD=Payyar-admin-2026
