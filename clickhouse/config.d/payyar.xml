<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
    <!-- Small demo box: keep ClickHouse inside its container memory limit. -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <!-- Trim noisy system logs that would otherwise grow forever on a laptop. -->
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
</clickhouse>
